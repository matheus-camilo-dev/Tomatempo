# Copie para .env e preencha localmente. O .env NUNCA é versionado (§7.5).
# Todos os valores abaixo são propositalmente falsos.

# --- Front (src/web) -------------------------------------------------------
VITE_API_URL=http://localhost:8080

# --- Banco local (docker compose) ------------------------------------------
# Qualquer valor serve: o banco é descartável e só escuta na sua máquina. O que não pode
# é ele estar versionado, por isso vive aqui como exemplo e no .env de verdade como valor.
POSTGRES_PASSWORD=changeme

# --- API (fase 2) ----------------------------------------------------------
# Em desenvolvimento use `dotnet user-secrets`, que guarda fora do repositório:
#   dotnet user-secrets set "Auth:Google:ClientSecret" "<valor real>"
# As linhas abaixo existem só para documentar as chaves esperadas.
ConnectionStrings__Db=Host=localhost;Port=5432;Database=tomatempo;Username=tomatempo;Password=changeme
Auth__Google__ClientId=changeme.apps.googleusercontent.com
Auth__Google__ClientSecret=changeme
Smtp__Host=localhost
Smtp__Port=1025
App__PublicUrl=http://localhost:5173

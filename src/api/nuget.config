<?xml version="1.0" encoding="utf-8"?>
<!--
  Fonte única e explícita: nuget.org. O <clear /> descarta qualquer feed herdado
  da máquina do desenvolvedor — build reproduzível e nenhuma dependência entrando
  por um caminho que o CI não enxerga (§7.2/A06, §7.3.5).
-->
<configuration>
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" protocolVersion="3" />
  </packageSources>
</configuration>
